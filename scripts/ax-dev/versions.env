# shellcheck shell=bash
# Pinned versions and defaults for the local Glue AX kind cluster.
# Re-verified 2026-11-10 against google/ax and agent-substrate/substrate.

export AX_REPO="${AX_REPO:-https://github.com/google/ax.git}"
export AX_COMMIT="${AX_COMMIT:-241bc4d0c682a6898da5f718a9ec84fe7c9197f9}"

export SUBSTRATE_REPO="${SUBSTRATE_REPO:-https://github.com/agent-substrate/substrate.git}"
export SUBSTRATE_TAG="${SUBSTRATE_TAG:-v1.0.0-rc.1}"
export SUBSTRATE_COMMIT="${SUBSTRATE_COMMIT:-f86fde9dfb5424c8d16f613de80469bdbef06541}"
export SUBSTRATE_IMAGE_REPO="${SUBSTRATE_IMAGE_REPO:-ghcr.io/agent-substrate/substrate}"

export KIND_VERSION="${KIND_VERSION:-v0.33.0}"
export GO_TOOLCHAIN="${GO_TOOLCHAIN:-go1.27.3}"
export GOTOOLCHAIN="${GOTOOLCHAIN:-auto}"
export GOWORK="off"

export KIND_CLUSTER_NAME="${KIND_CLUSTER_NAME:-glue-ax}"
export KUBE_CONTEXT="${KUBE_CONTEXT:-kind-${KIND_CLUSTER_NAME}}"
export AX_SYSTEM_NAMESPACE="${AX_SYSTEM_NAMESPACE:-ax-system}"
export GLUE_AX_WORKERS="${GLUE_AX_WORKERS:-4}"
export REGISTRY_NAME="${REGISTRY_NAME:-kind-registry}"
export REGISTRY_PORT="${REGISTRY_PORT:-5001}"
export REGISTRY_ADDR="${REGISTRY_ADDR:-localhost:${REGISTRY_PORT}}"

export STATE="${STATE:-${XDG_CACHE_HOME:-${HOME}/.cache}/glue/ax-dev}"
export KUBECONFIG="${KUBECONFIG:-${STATE}/kubeconfig}"
export PATH="${STATE}/bin:${PATH}"
